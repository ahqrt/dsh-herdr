{
  "name": "dsh-herdr",
  "version": "0.6.0",
  "description": "Delegate subtasks to Herdr-managed coding agents from DeepSeek Harness: pick the model, keep the pane, harvest the exact result, review in DSH.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./schema/agent-result.schema.json": "./schema/agent-result.schema.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skill",
    "schema",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "NOTICE",
    "LICENSE",
    "client",
    "scripts/build-client.mjs"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "herdr",
    "pi",
    "subagent",
    "multi-agent",
    "orchestration"
  ],
  "license": "MIT",
  "author": "ahqrt",
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahqrt/dsh-herdr.git"
  },
  "homepage": "https://github.com/ahqrt/dsh-herdr#readme",
  "bugs": {
    "url": "https://github.com/ahqrt/dsh-herdr/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": "0.2.1-rc.2",
      "dshReleases": {
        "0.2.1-rc.2": "compatible"
      }
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test \"test/*.test.mjs\"",
    "test:only": "node --test \"test/*.test.mjs\"",
    "pack": "pnpm build && npm pack",
    "test:coverage": "pnpm build && node --test --experimental-test-coverage \"test/*.test.mjs\"",
    "live": "pnpm build && node scripts/live-smoke.mjs",
    "format": "biome format --write src test scripts",
    "format:check": "biome format src test scripts",
    "build:client": "node scripts/build-client.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.4.1"
}
